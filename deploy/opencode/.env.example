# Copy to .env and fill. .env is gitignored; never commit real values.
#
# The application image is clean. Everything personal is injected here at
# deploy time and persisted only in the `kirocrew-home` volume.

# ── Image / build ──────────────────────────────────────────────────────────
KIROCREW_IMAGE=kirocrew-opencode:local
# Base official image; bump this to pick up upstream KiroCrew releases.
KIROCREW_PYTHON_BASE=python:3.12-slim-trixie
KIROCREW_VERSION=dev
# OpenCode version and the sha512 of its npm tarballs. `scripts/update-opencode.sh`
# fills these from the registry; leave them pinned for a reproducible build.
OPENCODE_VERSION=2.2.2
OPENCODE_SHA512_X64=c1ad289751d468a3434ea8dfa89c2a9aade7e2d95e8c1cb6513e3cc15442ca94541b2f566c8a5778bf719479a58c0a1d403e8771947676a8896054e50cca8854
OPENCODE_SHA512_ARM64=732a7a97548b14657b3715dde458012094fc5799908418ecf85f6f878a5149a9bd9111a6bff9d412f80f31729f36b65db2595394ba0fbf38075b3419cf67dfd4

# ── Networking ─────────────────────────────────────────────────────────────
# 127.0.0.1 keeps the dashboard host-local; put a TLS reverse proxy in front
# and set KIROCREW_PUBLIC_URL. Use 0.0.0.0 only on a trusted private network.
KIROCREW_BIND_HOST=127.0.0.1
KIROCREW_PORT=5476
KIROCREW_PUBLIC_URL=
TZ=Europe/Rome

# ── Model / harness ────────────────────────────────────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_VISION_MODEL=nvidia/nemotron-3.5-super-vl:free
KIROCREW_MODEL=openrouter/nvidia/nemotron-3-ultra-550b-a55b:free
KIROCREW_REASONING_EFFORT=high
KIROCREW_FALLBACK_MODEL=openrouter/nvidia/nemotron-3-ultra-550b-a55b:free
# Set to 1 to keep a model chosen in the dashboard instead of the stack default.
KIROCREW_PRESERVE_AGENT_MODEL=

# ── Channels ───────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram numeric user IDs allowed to command the bot.
TELEGRAM_ALLOWED_USER_IDS=
KIROCREW_OWNER_ID=

# Other KiroCrew channels. Leave empty to disable.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
DISCORD_BOT_TOKEN=
WECOM_BOT_ID=
WECOM_SECRET=
WEBEX_BOT_TOKEN=
WEIXIN_TOKEN=
FEISHU_APP_ID=
FEISHU_APP_SECRET=
MICROSOFT_APP_ID=
MICROSOFT_APP_PASSWORD=
MICROSOFT_APP_TENANT_ID=
JIRA_API_TOKEN=
AZURE_DEVOPS_EXT_PAT=
BITBUCKET_EMAIL=
BITBUCKET_API_TOKEN=

KIROCREW_ENABLE_WHATSAPP=1
WHATSAPP_ALLOWED_WA_IDS=
# Optional kiro-cli credential; OpenCode does not use it, the kiro backend does.
KIRO_API_KEY=

# ── Speech-to-text ─────────────────────────────────────────────────────────
KIROCREW_STT_PROVIDER=local
KIROCREW_STT_MODEL=small
KIROCREW_STT_LANGUAGE=it

# ── First-run behaviour ────────────────────────────────────────────────────
# 1 skips the onboarding wizard (the stack already seeded the model and keys).
KIROCREW_SKIP_ONBOARDING=1
# 1 lets the agent run tools without per-call approval, like the ASUS setup.
# The container sandbox is the boundary. Set 0 for an approval-first deployment.
KIROCREW_YOLO=1
KIROCREW_APPROVAL_MODE=auto
# 1 accepts container-only isolation if the inner sandbox is refused.
KIROCREW_ALLOW_UNSANDBOXED=1
