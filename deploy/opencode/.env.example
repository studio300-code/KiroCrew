# Copy to .env and fill. .env is gitignored; never commit real values.
#
# The application image is clean. Everything personal is injected here at
# deploy time and persisted only in the `kirocrew-home` volume.

# ── Image / build ──────────────────────────────────────────────────────────
KIROCREW_IMAGE=kirocrew-opencode:local
# Base official image; bump this to pick up upstream KiroCrew releases.
KIROCREW_PYTHON_BASE=python:3.12-slim-trixie
KIROCREW_VERSION=dev
# OpenCode version and the sha512 of its npm tarballs. `scripts/update-opencode.sh`
# fills these from the registry; leave them pinned for a reproducible build.
OPENCODE_VERSION=2.2.4
OPENCODE_SHA512_X64=ad66e708e3ff9c837c20b02dd2172ec39d6c35bb97fb3708992097eed3d40ac69881534b719ef7c217d6e2561cd3864c3e1c5ec92a2837422f7cbbe7b1a25f81
OPENCODE_SHA512_ARM64=306c2b77238b27660c84097d93f253a632c7a7cc82ab0ea0a83293d0630e80fbb9ea830e65268c51483c8492b716adbbb8638540b894b40dec6e175083794500

# ── Networking ─────────────────────────────────────────────────────────────
# 127.0.0.1 keeps the dashboard host-local; put a TLS reverse proxy in front
# and set KIROCREW_PUBLIC_URL. Use 0.0.0.0 only on a trusted private network.
KIROCREW_BIND_HOST=127.0.0.1
KIROCREW_PORT=5476
KIROCREW_PUBLIC_URL=
TZ=Europe/Rome

# ── Model / harness ────────────────────────────────────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_VISION_MODEL=nvidia/nemotron-3.5-super-vl:free
KIROCREW_MODEL=openrouter/nvidia/nemotron-3-ultra-550b-a55b:free
KIROCREW_REASONING_EFFORT=high
KIROCREW_FALLBACK_MODEL=openrouter/nvidia/nemotron-3-ultra-550b-a55b:free
# Set to 1 to keep a model chosen in the dashboard instead of the stack default.
KIROCREW_PRESERVE_AGENT_MODEL=

# ── Skills ─────────────────────────────────────────────────────────────────
# Learn reusable procedures from finished sessions. Approval is off so
# prose-only candidates publish themselves; script generation is off, so no
# candidate waits for a human. A script-bundling skill would still be gated by
# design. Leave a variable unset to keep the dashboard choice in the volume.
KIROCREW_SKILLS_AUTO_CREATE=1
KIROCREW_SKILLS_AUTO_REFINE=1
KIROCREW_SKILLS_REQUIRE_APPROVAL=0
KIROCREW_SKILLS_GENERATE_SCRIPTS=0

# ── Channels ───────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram numeric user IDs allowed to command the bot.
TELEGRAM_ALLOWED_USER_IDS=
# A token enables Telegram on a fresh volume. Set 1 to force-enable it on an
# existing volume after adding a token; set 0 to keep it disabled.
KIROCREW_ENABLE_TELEGRAM=
KIROCREW_OWNER_ID=

# Other KiroCrew channels. Leave empty to disable.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
DISCORD_BOT_TOKEN=
WECOM_BOT_ID=
WECOM_SECRET=
WEBEX_BOT_TOKEN=
WEIXIN_TOKEN=
FEISHU_APP_ID=
FEISHU_APP_SECRET=
MICROSOFT_APP_ID=
MICROSOFT_APP_PASSWORD=
MICROSOFT_APP_TENANT_ID=
JIRA_API_TOKEN=
AZURE_DEVOPS_EXT_PAT=
BITBUCKET_EMAIL=
BITBUCKET_API_TOKEN=

KIROCREW_ENABLE_WHATSAPP=1
# Phone number used by scripts/whatsapp-pair.sh when no CLI argument is given.
# Digits only, with country code; no + or spaces.
WHATSAPP_PAIR_PHONE=
WHATSAPP_ALLOWED_WA_IDS=
# Optional kiro-cli credential; OpenCode does not use it, the kiro backend does.
KIRO_API_KEY=

# ── Speech-to-text ─────────────────────────────────────────────────────────
KIROCREW_STT_PROVIDER=local
KIROCREW_STT_MODEL=small
KIROCREW_STT_LANGUAGE=it

# ── Orukeet (optional compose.orukeet.yaml) ────────────────────────────────
# The ASUS keeps the model resident on CUDA on the host; the container shares
# that socket instead of loading a second copy on the 2 GB GPU. Point these at
# the host paths when the override is used.
ORUKEET_CACHE_DIR=/home/marco/.cache
ORUKEET_NATIVE_DIR=/home/marco/.local/share/orukeet-native

# ── First-run behaviour ────────────────────────────────────────────────────
# 1 skips the onboarding wizard (the stack already seeded the model and keys).
KIROCREW_SKIP_ONBOARDING=1
# 1 lets the agent run tools without per-call approval, like the ASUS setup.
# The container sandbox is the boundary. Set 0 for an approval-first deployment.
KIROCREW_YOLO=1
KIROCREW_APPROVAL_MODE=auto
# 1 accepts container-only isolation if the inner sandbox is refused.
KIROCREW_ALLOW_UNSANDBOXED=1
# auto: the inner mount namespace the OpenCode harness requires. strict: also
# hide AWS/SSH/Kube credentials from the agent's shell. Do not set off: the
# harness refuses to spawn unsandboxed and every turn fails.
KIROCREW_SANDBOX=auto
